#!/usr/bin/env python3
"""cloke - one package manager for ClokeOS, macOS, Linux and Windows software.

  cloke install <name>      search every backend, let you pick a version, install it
  cloke search <name>       show what is available and from where
  cloke remove <name>       remove a package that cloke installed
  cloke list                packages installed through cloke
  cloke update              upgrade everything cloke installed
  cloke backends            which backends and compatibility layers this system has

Backends (used when present on this system): brew | dnf, apt, pacman, flatpak, AppImage |
winget, choco. Software for another OS is offered too and installed through a compatibility
layer: Windows programs through Raven (the installer comes from the winget-pkgs manifests),
Linux programs through the layer named in CLOKE_LINUX_LAYER (a command that runs its arguments
inside a Linux environment, for example "cloke-linux --").

Options: -y/--yes takes the recommended version without asking, --from <backend> picks a backend,
--os macos|linux|windows limits the list to one OS, --json (search) prints machine-readable output.
"""
import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

# Pythons urllib.request lädt unter macOS _scproxy (liest die Proxy-Einstellungen über
# SystemConfiguration). Das gibt es auf ClokeOS nicht (dlopen schlägt fehl, cloke startete gar nicht);
# ohne das Modul gelten die Umgebungsvariablen http_proxy/https_proxy.
if sys.platform == "darwin":
    try:
        import _scproxy  # noqa: F401
    except ImportError:
        import types
        _m = types.ModuleType("_scproxy")
        _m._get_proxy_settings = lambda: {"exclude_simple": False, "exceptions": []}
        _m._get_proxies = lambda: {}
        sys.modules["_scproxy"] = _m
import urllib.error  # noqa: E402
import urllib.request  # noqa: E402

VERSION = "0.2"
HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")), "cloke")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "cloke")
STATE = os.path.join(DATA, "installed.json")            # Benutzer-Bereich
SYSTEM_STATE = "/var/lib/cloke/installed.json"          # systemweit (nur root)
APPS_INDEX = os.environ.get("CLOKE_APPS_INDEX", "https://raw.githubusercontent.com/cloke-tech/ClokeOS-Apps/main/index.json")
USER_APPS = os.path.join(HOME, "Applications")
OFFLINE = bool(os.environ.get("CLOKE_OFFLINE"))
FAILED = set()   # Befehle, die zuletzt fehlschlugen (leere Ausgabe heißt dann nicht "keine Treffer")

# Homebrew liegt auf ClokeOS nicht im PATH jeder Shell (arm64: /opt/homebrew, x86_64: /usr/local).
for _b in ("/opt/homebrew/bin", "/usr/local/bin"):
    if os.path.exists(_b + "/brew") and _b not in os.environ.get("PATH", "").split(":"):
        os.environ["PATH"] = os.environ.get("PATH", "") + ":" + _b

# Which OS this program is running on. ClokeOS is Darwin, so it counts as macOS.
HOST = {"darwin": "macos", "linux": "linux", "win32": "windows", "cygwin": "windows"}.get(sys.platform, "linux")
ARCH = platform.machine().lower()

OS_LABEL = {"macos": "macOS", "linux": "Linux", "windows": "Windows"}
# Native first, then the order in which the OSes make sense as a fallback.
OS_ORDER = {
    "macos": ["macos", "linux", "windows"],
    "linux": ["linux", "windows", "macos"],
    "windows": ["windows", "linux", "macos"],
}[HOST]

# backend -> (OS it installs for, command it needs, sort rank inside that OS)
BACKENDS = {
    "apps": ("macos", None, 0),
    "brew": ("macos", "brew", 1),
    "apk": ("linux", None, -1),
    "dnf": ("linux", "dnf", 0),
    "apt": ("linux", "apt-get", 1),
    "pacman": ("linux", "pacman", 2),
    "flatpak": ("linux", "flatpak", 3),
    "appimage": ("linux", None, 4),
    "winget": ("windows", "winget", 0),
    "choco": ("windows", "choco", 1),
}

# Popular programs with their ids per backend, so other OSes' versions can be listed even where
# that OS's package manager does not exist. "cask:" marks a Homebrew cask (a GUI app bundle).
CATALOG = {
    "steam": {"brew": "cask:steam", "dnf": "steam", "flatpak": "com.valvesoftware.Steam", "winget": "Valve.Steam", "choco": "steam-client"},
    "firefox": {"brew": "cask:firefox", "dnf": "firefox", "flatpak": "org.mozilla.firefox", "winget": "Mozilla.Firefox", "choco": "firefox"},
    "vlc": {"brew": "cask:vlc", "dnf": "vlc", "flatpak": "org.videolan.VLC", "winget": "VideoLAN.VLC", "choco": "vlc"},
    "git": {"brew": "git", "dnf": "git", "apt": "git", "pacman": "git", "winget": "Git.Git", "choco": "git"},
    "python": {"brew": "python", "dnf": "python3", "apt": "python3", "pacman": "python", "winget": "Python.Python.3.13", "choco": "python"},
    "nodejs": {"brew": "node", "dnf": "nodejs", "apt": "nodejs", "pacman": "nodejs", "winget": "OpenJS.NodeJS", "choco": "nodejs"},
    "vscode": {"brew": "cask:visual-studio-code", "flatpak": "com.visualstudio.code", "winget": "Microsoft.VisualStudioCode", "choco": "vscode"},
    "discord": {"brew": "cask:discord", "flatpak": "com.discordapp.Discord", "winget": "Discord.Discord", "choco": "discord"},
    "spotify": {"brew": "cask:spotify", "flatpak": "com.spotify.Client", "winget": "Spotify.Spotify", "choco": "spotify"},
    "obs": {"brew": "cask:obs", "dnf": "obs-studio", "flatpak": "com.obsproject.Studio", "winget": "OBSProject.OBSStudio", "choco": "obs-studio"},
    "gimp": {"brew": "cask:gimp", "dnf": "gimp", "flatpak": "org.gimp.GIMP", "winget": "GIMP.GIMP.3", "choco": "gimp"},
    "blender": {"brew": "cask:blender", "dnf": "blender", "flatpak": "org.blender.Blender", "winget": "BlenderFoundation.Blender", "choco": "blender"},
    "libreoffice": {"brew": "cask:libreoffice", "dnf": "libreoffice", "flatpak": "org.libreoffice.LibreOffice", "winget": "TheDocumentFoundation.LibreOffice", "choco": "libreoffice-fresh"},
    "telegram": {"brew": "cask:telegram", "flatpak": "org.telegram.desktop", "winget": "Telegram.TelegramDesktop", "choco": "telegram"},
    "signal": {"brew": "cask:signal", "flatpak": "org.signal.Signal", "winget": "OpenWhisperSystems.Signal", "choco": "signal"},
