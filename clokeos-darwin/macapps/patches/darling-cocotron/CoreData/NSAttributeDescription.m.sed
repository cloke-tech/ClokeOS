# ClokeOS: im Code gebaute Attribute bekommen den Werteklassennamen aus dem Typ (wie bei Apple; .mom-Dateien bringen ihn mit)
/^- \(void\) setAttributeType: \(NSAttributeType\) value \{$/,/^\}$/s/^    _attributeType = value;$/    _attributeType = value;\n    const char *cn = NULL;\n    switch ((int) value) {\n    case 100: case 200: case 300: case 500: case 600: case 800: cn = "NSNumber"; break;\n    case 400: cn = "NSDecimalNumber"; break;\n    case 700: cn = "NSString"; break;\n    case 900: cn = "NSDate"; break;\n    case 1000: cn = "NSData"; break;\n    case 1100: cn = "NSUUID"; break;\n    case 1200: cn = "NSURL"; break;\n    }\n    [_valueClassName release];\n    _valueClassName = cn ? [[NSString alloc] initWithUTF8String: cn] : nil;/
