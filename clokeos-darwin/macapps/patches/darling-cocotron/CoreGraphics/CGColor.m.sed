# ClokeOS: CLOKE_CG_TRACE=1 meldet CGColor-Erzeugungen mit vier Anteilen, die alle 0 sind (durchsichtig), mit Aufrufkette (Fehlersuche)
s|^#import <CoreGraphics/CGColor.h>$|#import <CoreGraphics/CGColor.h>\n#import <execinfo.h>\n#import <dlfcn.h>\n#import <stdio.h>\n#import <stdlib.h>\n#import <string.h>\nstatic void clk_zero_trace(const CGFloat *c, size_t n) {\n    static int on = -1, count;\n    if (on < 0) on = getenv("CLOKE_CG_TRACE") != NULL;\n    if (!on \|\| !c \|\| n != 4 \|\| c[0] != 0 \|\| c[1] != 0 \|\| c[2] != 0 \|\| c[3] != 0 \|\| count++ >= 40) return;\n    void *pcs[24];\n    int k = backtrace(pcs, 24);\n    fprintf(stderr, "[clokeos-cg] CGColor (0,0,0,0)\\n");\n    for (int i = 1; i < k; i++) {\n        Dl_info di;\n        if (dladdr(pcs[i], \&di) \&\& di.dli_fname)\n            fprintf(stderr, "[clokeos-cg]   %s +%#lx %s\\n", strrchr(di.dli_fname, '/') ? strrchr(di.dli_fname, '/') + 1 : di.dli_fname, (unsigned long) ((char *) pcs[i] - (char *) di.dli_fbase), di.dli_sname ? di.dli_sname : "");\n    }\n}|
/^CGColorRef CGColorCreate\(CGColorSpaceRef colorSpace, const CGFloat \*components\)$/,/^\}$/s/^    return \(CGColorRef\)O2ColorCreate/    clk_zero_trace(components, colorSpace ? CGColorSpaceGetNumberOfComponents(colorSpace) + 1 : 0);\n    return (CGColorRef)O2ColorCreate/
