# ClokeOS: setShowsMenuIndicator:forSegment: / showsMenuIndicatorForSegment: (ab macOS 10.13), an die Zelle weitergereicht
s/^@implementation NSSegmentedControl$/&\n\n- (void) setShowsMenuIndicator: (BOOL) shows forSegment: (NSInteger) segment {\n    if ([_cell respondsToSelector: @selector(setMenuIndicatorShown:forSegment:)])\n        [(id) _cell setMenuIndicatorShown: shows forSegment: segment];\n    [(id) self invalidateIntrinsicContentSize];\n    [self setNeedsDisplay: YES];\n}\n\n- (BOOL) showsMenuIndicatorForSegment: (NSInteger) segment {\n    return [_cell respondsToSelector: @selector(isMenuIndicatorShownForSegment:)] \&\& [(id) _cell isMenuIndicatorShownForSegment: segment];\n}\n/
