# ClokeOS: setSelectedSegment:-1 (oder außerhalb) wählt wie bei Apple nichts aus, statt mit einem ungültigen Index in die Segmentliste zu greifen
# (NSRangeException in Logic Pros Transportleiste).
/^- \(void\) setSelectedSegment: \(NSInteger\) segment \{$/,/^\}$/s/^    \[\[_segments objectAtIndex: segment\] setSelected: YES\];$/    if (segment >= 0 \&\& segment < (NSInteger) [_segments count])\n        [[_segments objectAtIndex: segment] setSelected: YES];\n    else\n        _selectedSegment = -1;/
# ClokeOS: _labelRectForSegment:inFrame:withView: (privat bei Apple; Logic Pros MASegmentedCell überschreibt es und ruft super): das
# Rechteck der Beschriftung im Segment, waagerecht 4 Punkte eingerückt, senkrecht in der Mitte auf Schrifthöhe
s/^- \(NSSize\) cellSize \{$/- (NSRect) _labelRectForSegment: (NSInteger) segment inFrame: (NSRect) frame withView: (NSView *) view {\n    NSFont *f = [self font] ? [self font] : [NSFont systemFontOfSize: [NSFont systemFontSize]];\n    CGFloat h = MIN(frame.size.height, ceil([f ascender] - [f descender]) + 2);\n    return NSMakeRect(frame.origin.x + 4, frame.origin.y + floor((frame.size.height - h) \/ 2), MAX(0, frame.size.width - 8), h);\n}\n\n- (NSSize) cellSize {/
# ClokeOS: _rectForSegment:inFrame: (privat bei Apple): Rechteck eines Segments im Zellrahmen, mit denselben Breiten wie drawWithFrame:.
# MAToolKit fragt respondsToSelector: und setzt damit die Menüpfeile; ohne die Methode lagen sie falsch und die Beschriftungen von
# Logic Pros „Bearbeiten / Funktionen / Darstellung“ bekamen negative Breiten.
s/^- \(void\) _wasDrawnWithFrame: \(NSRect\) cellFrame inView: \(NSView \*\) controlView \{$/- (NSRect) _rectForSegment: (NSInteger) segment inFrame: (NSRect) frame {\n    NSInteger count = [self segmentCount];\n    if ([_segmentComputedWidths count] != count)\n        [self _recomputeSegmentWidths];\n    NSRect r = frame;\n    for (NSInteger i = 0; i < count; i++) {\n        r.size.width = [[_segmentComputedWidths objectAtIndex: i] doubleValue];\n        if (i == segment)\n            return r;\n        r.origin.x += r.size.width;\n    }\n    return NSZeroRect;\n}\n\n&/
# ClokeOS: Menüpfeile je Segment (setShowsMenuIndicator:forSegment: ab macOS 10.13, an der Zelle setMenuIndicatorShown:forSegment:).
# Automatisch breite Segmente bekommen wie bei Apple Platz für den Pfeil; sonst waren Logic Pros Menü-Segmente zu schmal für ihre Titel.
s/^(#import <AppKit\/NSSegmentedCell.h>)$/\1\n#import <objc\/runtime.h>\nstatic char clk_menu_shown;\n#define CLK_MENU_INDICATOR_WIDTH 16/
s/^@implementation NSSegmentedCell$/&\n\n- (void) setMenuIndicatorShown: (BOOL) shown forSegment: (NSInteger) segment {\n    NSMutableIndexSet *s = objc_getAssociatedObject(self, \&clk_menu_shown);\n    if (s == nil) {\n        s = [NSMutableIndexSet indexSet];\n        objc_setAssociatedObject(self, \&clk_menu_shown, s, OBJC_ASSOCIATION_RETAIN_NONATOMIC);\n    }\n    if (segment < 0)\n        return;\n    if (shown)\n        [s addIndex: segment];\n    else\n        [s removeIndex: segment];\n    [_segmentComputedWidths removeAllObjects];\n}\n\n- (BOOL) isMenuIndicatorShownForSegment: (NSInteger) segment {\n    return segment >= 0 \&\& [objc_getAssociatedObject(self, \&clk_menu_shown) containsIndex: segment];\n}\n/
s/^            w = \[cell cellSize\]\.width;$/&\n            if ([self isMenuIndicatorShownForSegment: i])\n                w += CLK_MENU_INDICATOR_WIDTH;/
