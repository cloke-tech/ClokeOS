# CMake-Toolchain: Cross-Build für PureDarwin 20.5 arm64 auf dem Mac (Header/Bibliotheken aus dem Image, webkit/sysroot.sh)
set(SR "$ENV{WEBKIT_SYSROOT}")
# System-Header (Mach, os, libc++) vom Apple-SDK des Macs: PureDarwins Header-Satz ist lückenhaft (kein os/lock.h,
# mach/thread_act.h, mach-o/dyld.h ...). Bibliotheken und Drittanbieter-Header (glib, gtk, icu ...) kommen aus dem Image.
execute_process(COMMAND xcrun --show-sdk-path OUTPUT_VARIABLE SDK OUTPUT_STRIP_TRAILING_WHITESPACE)
# CMake soll Linux annehmen: der WebKit-Tarball enthält keine Apple-Quellen (mac, cocoa). Ziel bleibt Mach-O (clang -target).
set(CMAKE_SYSTEM_NAME PureDarwin) # unbekannter Name: WebKit nimmt die generischen Pfade (nicht Linux, nicht Apple)
set(UNIX TRUE)
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
set(CMAKE_SHARED_LIBRARY_CREATE_C_FLAGS "-dynamiclib")
set(CMAKE_SHARED_LIBRARY_CREATE_CXX_FLAGS "-dynamiclib")
set(CMAKE_SYSTEM_PROCESSOR $ENV{WEBKIT_ARCH})
set(CMAKE_CROSSCOMPILING TRUE)
set(CMAKE_C_COMPILER /usr/bin/clang)
set(CMAKE_CXX_COMPILER /usr/bin/clang++)
set(CMAKE_FIND_ROOT_PATH "${SR}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
# pkg-config liefert absolute Pfade im Sysroot, deshalb BOTH; die Host-Suchpfade (/usr, /opt/homebrew) sind abgeschaltet
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_FIND_USE_CMAKE_SYSTEM_PATH FALSE)
set(CMAKE_PREFIX_PATH "${SR};${SR}/usr")
set(CMAKE_LIBRARY_PATH "${SR}/lib;${SR}/usr/lib")
set(CMAKE_INCLUDE_PATH "${SR}/include;${SR}/usr/include")
set(CMAKE_C_COMPILER_TARGET $ENV{WEBKIT_ARCH}-apple-macos11.0)
set(CMAKE_CXX_COMPILER_TARGET $ENV{WEBKIT_ARCH}-apple-macos11.0)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# PLATFORM_MacOSX: PureDarwins sys/cdefs.h wählt sonst $UNIX2003-Symbole; kein ___chkstk_darwin in PDs libSystem
set(CMAKE_C_FLAGS_INIT "-isysroot ${SDK} -isystem ${SR}/include -DCLOKEOS_PD=1 -DBUSE_TZONE=0 -DUSE_TZONE_MALLOC=0 -isystem ${SR}/glinc -I$ENV{WEBKIT_SRC}/Source/WTF -I${CMAKE_CURRENT_LIST_DIR}/shim -fno-stack-check")
set(CMAKE_CXX_FLAGS_INIT "-isysroot ${SDK} -isystem ${SR}/include -DCLOKEOS_PD=1 -DBUSE_TZONE=0 -DUSE_TZONE_MALLOC=0 -isystem ${SR}/glinc -I$ENV{WEBKIT_SRC}/Source/WTF -I${CMAKE_CURRENT_LIST_DIR}/shim -fno-stack-check -nostdlib++ -stdlib=libc++ ")
set(LNK "-isysroot ${SDK} -nostdlib -L${SR}/usr/lib -L${SR}/lib -Wl,-platform_version,macos,11.0,11.5 -Wl,-no_fixup_chains")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${LNK}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${LNK}")
set(CMAKE_C_STANDARD_LIBRARIES "-lSystem")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lSystem")
set(ENV{PKG_CONFIG_LIBDIR} "${SR}/lib/pkgconfig:${SR}/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${SR}")
# pthreads stecken in libSystem; try_compile linkt nicht (STATIC_LIBRARY), daher vorgeben
set(CMAKE_HAVE_LIBC_PTHREAD 1 CACHE INTERNAL "")
set(CMAKE_THREAD_LIBS_INIT "" CACHE INTERNAL "")
set(CMAKE_HAVE_THREADS_LIBRARY 1 CACHE INTERNAL "")
set(CMAKE_USE_PTHREADS_INIT 1 CACHE INTERNAL "")
set(CMAKE_FIND_LIBRARY_SUFFIXES ".dylib;.a")
set(CMAKE_SHARED_LIBRARY_SUFFIX ".dylib")
set(CMAKE_FIND_LIBRARY_PREFIXES "lib")
set(PD_DARWIN ON) # ClokeOS: Mach-O-Ziel (von WebKit-Patches abgefragt)
set(CLOKEOS_COMPAT_DIR "${CMAKE_CURRENT_LIST_DIR}/compat")
# libpdcompat.a (compat/pdcompat.c, baut configure.sh) liegt im Sysroot
set(CMAKE_C_STANDARD_LIBRARIES "-lSystem -lpdcompat")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lSystem -lintl -lsharpyuv -lpdcompat")
set(CMAKE_PROJECT_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/after-project.cmake")
