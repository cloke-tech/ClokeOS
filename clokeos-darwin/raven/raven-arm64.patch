+// ClokeOS arm64: the few x86 intrinsics the host side uses
+#pragma once
+#if defined(__x86_64__)
+#include <x86intrin.h>
+#else
+#include <cstdint>
+// Unicorn's emulated time stamp counter counts nanoseconds, so the host's does too
+#include <time.h>
+static inline uint64_t __rdtsc() { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
+#endif
