 #!/usr/bin/env python3
 """PureDarwin's libc++.1.dylib (20.5) has std::uncaught_exceptions() as an abort ("not yet implemented"); iostream sentries
-inside the library call it. Replaces its first bytes by `xor eax,eax; ret` (no exception in flight).
+inside the library call it. Replaces its first bytes by `xor eax,eax; ret` (arm64: `mov w0,#0; ret`; no exception in flight).
 
   patch_libcxx.py <in> <out>
 """
@@ -17,7 +17,12 @@ for line in out.splitlines():
 if offset is None:
     sys.exit('uncaught_exceptions not found')
 # __TEXT starts at file offset 0 and vm address 0 in PureDarwin's libc++
-assert bytes(data[offset:offset + 1]) != b'\x31', 'already patched'
-data[offset:offset + 3] = b'\x31\xc0\xc3'
+# the machine code is the library's own: Mach-O cputype at byte 4 (0x0100000c is arm64)
+if int.from_bytes(data[4:8], 'little') == 0x0100000c:
+    patch = bytes.fromhex('00008052c0035fd6')   # mov w0, #0; ret
+else:
+    patch = b'\x31\xc0\xc3'   # xor eax, eax; ret
+assert bytes(data[offset:offset + len(patch)]) != patch, 'already patched'
+data[offset:offset + len(patch)] = patch
 open(dst, 'wb').write(data)
 print('patched uncaught_exceptions at', hex(offset))
diff --git a/native/platform/unicorn_guest.cpp b/native/platform/unicorn_guest.cpp
new file mode 100644
index 0000000..115cc06
--- /dev/null
+++ b/native/platform/unicorn_guest.cpp
@@ -0,0 +1,1214 @@
+// ClokeOS arm64: guest-process control with Unicorn, see mach_guest.h
+// Raven drives its x86-64 guest with ptrace-like calls (cpu/native_cpu.cpp). On x86_64 hosts the guest is a real process; on arm64
+// there is no x86 code to run natively, so the guest lives in a Unicorn engine inside this process and the same calls are answered
+// from it: registers from uc_reg_read/write, memory from guest regions that are host memory mapped into the engine, stops from the
+// hooks (int3, syscall instruction, faults). Unicorn is GPL-2.0, Raven GPL-3.0.
+#ifdef RAVEN_UNICORN
+#include "platform/mach_guest.h"
+
+#include <algorithm>
+#include <condition_variable>
+#include <thread>
+#include <atomic>
+#include <cerrno>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unicorn/unicorn.h>
+#include <vector>
+
+#include "platform/darwin_compat.h"
+#undef ptrace
+
+#ifdef RAVEN_JIT
+// ClokeOS: block JIT x86-64 -> arm64 (xlat/jit) as the engine for 64-bit guests; Unicorn stays as the fallback for instructions the JIT
+// does not translate and as the engine of 32-bit guests. RAVEN_JIT=1 selects it at runtime.
+extern "C" {
+#include "jit.h"
+}
+static volatile bool *jit_fb_stop_flag = nullptr;
+#include <unordered_map>
+static std::unordered_map<uint64_t, std::pair<uint64_t, uint64_t>> *jit_fb_histogram = nullptr;   // RAVEN_TRACE_STATS: where the fallbacks happen   // set by the hooks: the fallback run ended because of a stop event
+#define JIT_FB_STOP_PTR jit_fb_stop_flag
+#include "ucsync.h"
+#endif
+
+namespace {
+
+// RAVEN_TRACE_STATS=1: counters printed when the guest is gone
+struct Stats {
+	uint64_t starts = 0, emu_ns = 0, syscalls[512] = {}, reads = 0, writes = 0, protects = 0, steps = 0;
+	~Stats()
+	{
+		if (!std::getenv("RAVEN_TRACE_STATS") || !starts)
+			return;
+#ifdef RAVEN_JIT
+		{
+			uint64_t blocks = 0, insns = 0, fallbacks = 0;
+			jit_stats(&blocks, &insns, &fallbacks);
+			if (jit_fb_histogram) {
+				std::vector<std::pair<uint64_t, uint64_t>> top;
+				for (const auto &[at, entry] : *jit_fb_histogram) top.emplace_back(entry.first, at);
+				std::sort(top.rbegin(), top.rend());
+				for (size_t index = 0; index < top.size() && index < 12; ++index) {
+					const auto &entry = (*jit_fb_histogram)[top[index].second];
+					std::fprintf(stderr, "raven:   fallback at %llx x %llu bytes", (unsigned long long)top[index].second, (unsigned long long)top[index].first);
+					for (int byte = 0; byte < 8; ++byte) std::fprintf(stderr, " %02x", unsigned((entry.second >> (8 * byte)) & 0xff));
+					std::fprintf(stderr, "\n");
+				}
+			}
+			uint64_t more[4] = {};
+			jit_stats2(more);
+			if (blocks)
+				std::fprintf(stderr, "raven: JIT code invalidations %llu, harmless code-page writes %llu, flushes %llu\n", (unsigned long long)more[0], (unsigned long long)more[1], (unsigned long long)more[2]);
+			if (blocks)
+				std::fprintf(stderr, "raven: JIT %llu blocks, %llu instructions translated, %llu fallbacks to Unicorn (%lu runs)\n", (unsigned long long)blocks,
+					(unsigned long long)insns, (unsigned long long)fallbacks, jit_nfb);
+		}
+#endif
+		std::fprintf(stderr, "raven: unicorn starts=%llu in-emulation=%.2fs host-reads=%llu host-writes=%llu protects=%llu\n", (unsigned long long)starts,
+			double(emu_ns) / 1e9, (unsigned long long)reads, (unsigned long long)writes, (unsigned long long)protects);
+		for (int number = 0; number < 512; ++number)
+			if (syscalls[number])
+				std::fprintf(stderr, "raven:   syscall %d x %llu\n", number, (unsigned long long)syscalls[number]);
+	}
+} stats;
+
+std::mutex children_lock;
+std::mutex images_lock;
+std::map<int, std::pair<void *, size_t>> images;
+std::map<pid_t, raven::NativeChild *> children;
+
+// The gate of the bootstrap of x86_64 hosts: int3; syscall; int3; ud2, at the address that program was linked at
+constexpr uint64_t gate_address = 0x700000000000ULL;
+constexpr uint64_t anywhere_start = 0x100000000000ULL;
+#ifdef RAVEN_JIT
+// With the JIT the guest's memory lives in one window of the host's address space (guest address + delta), so every guest address is
+// below the window's size: user area [0x10000, limit-2 GiB), the runtime's providers in the next GiB, free choice of the engine above.
+std::atomic<bool> jit_claimed{false};
+uint64_t jit_window()
+{
+	static const uint64_t size = [] {
+		const char *v = std::getenv("RAVEN_JIT");
+		if (!(v && *v && *v != '0'))
+			return uint64_t(0);
+		// Raven's allocator starts at 8 GiB: a window of 16 GiB is the least that leaves it room (a smaller one is what the host gives when
+		// address space is short; then the guest runs on Unicorn as without RAVEN_JIT)
+		const uint64_t limit = jit_guest_limit();
+		if (limit < (uint64_t(1) << 34)) {
+			std::fprintf(stderr, "raven: RAVEN_JIT: the JIT window is only %llu MiB, running on Unicorn\n", (unsigned long long)(limit >> 20));
+			return uint64_t(0);
+		}
+		return limit;
+	}();
+	return size;
+}
+#endif
+constexpr uint64_t host_page = 0x4000;
+
+uint64_t round_up(uint64_t value, uint64_t granule) { return (value + granule - 1) & ~(granule - 1); }
+
+uint32_t unicorn_rights(int protection)
+{
+	uint32_t rights = 0;
+	if (protection & PROT_READ) rights |= UC_PROT_READ;
+	if (protection & PROT_WRITE) rights |= UC_PROT_WRITE;
+	if (protection & PROT_EXEC) rights |= UC_PROT_EXEC;
+	return rights;
+}
+
+[[noreturn]] void fail(const std::string &what, uc_err result)
+{
+	throw std::runtime_error("native " + what + ": " + uc_strerror(result));
+}
+
+// Host memory a guest region is made of; it is released with the last region that uses it.
+struct HostBlock {
+	void *base = nullptr;
+	size_t size = 0;
+	bool mapped = false;   // made with mmap (anonymous or a shared object), not the storage of a PE image
+	~HostBlock()
+	{
+		if (mapped && base)
+			munmap(base, size);
+	}
+};
+
+struct Region {
+	uint64_t size = 0;
+	uint8_t *host = nullptr;   // the host memory of the region's first byte
+	std::shared_ptr<HostBlock> block;
+};
+
+}
