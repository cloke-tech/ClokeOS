+namespace raven {
+
+uint64_t user_limit_value()
+{
+#ifdef RAVEN_JIT
+	if (jit_window())
+		return jit_window() - 0x80000000ULL;
+#endif
+	return 0x7fffffff0000ULL;
+}
+
+uint64_t provider_base_value()
+{
+#ifdef RAVEN_JIT
+	if (jit_window())
+		return jit_window() - 0x80000000ULL;
+#endif
+	return 0x6fff00000000ULL;
+}
+
+struct NativeChild::Emu {
+	uc_engine *uc = nullptr;
+	uc_hook hooks[8] = {};
+	size_t hook_count = 0;
+	// The guest's regions by start address; they never overlap.
+	std::map<uint64_t, Region> regions;
+	// What stopped the guest last, as a Linux signal with the siginfo fields ptrace would report
+	bool stopped = true, run = false, step = false, happened = false;
+	int signal = 0, code = 0;
+	uint64_t address = 0;
+	uint64_t syscall_number = uint64_t(-1);
+	// The size of a pending timeout and the stop reason a hook recorded
+	uint64_t stop_rip = 0;
+	std::atomic<bool> closing{false};
+	// The timeout of a run: uc_emu_start would create a thread for it at every start (and a start follows every API call), so one
+	// watchdog thread waits for the deadline of the run in progress and stops the engine when it passes.
+	std::mutex watch_lock;
+	std::condition_variable watch_wake;
+	bool watch_armed = false, watch_quit = false;
+	std::chrono::steady_clock::time_point watch_deadline;
+	std::thread watchdog;
+	void start_watchdog()
+	{
+		watchdog = std::thread([this] {
+			std::unique_lock lock(watch_lock);
+			while (!watch_quit) {
+				if (!watch_armed) {
+					watch_wake.wait(lock);
+					continue;
+				}
+				if (watch_wake.wait_until(lock, watch_deadline) == std::cv_status::timeout && watch_armed && !watch_quit &&
+					std::chrono::steady_clock::now() >= watch_deadline) {
+						watch_armed = false;
+#ifdef RAVEN_JIT
+						jpend = 1;
+#endif
+						uc_emu_stop(uc);
+				}
+			}
+		});
+	}
+	void arm(std::chrono::steady_clock::time_point deadline)
+	{
+		{
+			std::lock_guard lock(watch_lock);
+			watch_deadline = deadline;
+			watch_armed = true;
+		}
+		watch_wake.notify_one();
+	}
+	void disarm()
+	{
+		std::lock_guard lock(watch_lock);
+		watch_armed = false;
+	}
+	void stop_watchdog()
+	{
+		{
+			std::lock_guard lock(watch_lock);
+			watch_quit = true;
+		}
+		watch_wake.notify_one();
+		if (watchdog.joinable())
+			watchdog.join();
+	}
+	// 32-bit guests run in compatibility mode: the first entry goes through a far jump in the stub page (it loads CS from the GDT the way
+	// the processor does, which writing the register does not), after that the engine stays in that mode.
+	bool compat = false, compat_pending = false;
+#ifdef RAVEN_JIT
+	// jit_mem: the guest's memory is the JIT's window; jit_cpu: 64-bit guest code runs in the JIT (the registers are in `jc`, not in Unicorn)
+	bool jit_mem = false, jit_cpu = false;
+	JitCtx *jc = nullptr;
+	volatile uint32_t jpend = 0;
+	volatile bool running_jit = false;
+	uint64_t jdelta = 0;
+#endif
+	uint64_t stub = 0;
+	uint16_t fs_shadow = 0;
+
+	uint64_t rip() const
+	{
+#ifdef RAVEN_JIT
+		if (jit_cpu)
+			return jc->rip;
+#endif
+		uint64_t value = 0;
+		uc_reg_read(uc, UC_X86_REG_RIP, &value);
+		return value;
+	}
+	void set_rip(uint64_t value)
+	{
+#ifdef RAVEN_JIT
+		if (jit_cpu) { jc->rip = value; return; }
+#endif
+		uc_reg_write(uc, UC_X86_REG_RIP, &value);
+	}
+
+	// The lowest free gap of `size` bytes in [low, limit) on a 64 KiB boundary
+	uint64_t find_gap(uint64_t size, uint64_t low, uint64_t limit) const
+	{
+		uint64_t candidate = round_up(low, 0x10000);
+		for (const auto &[base, region] : regions) {
+			if (base + region.size <= candidate)
+				continue;
+			if (base >= candidate && base - candidate >= size)
+				break;
+			candidate = round_up(base + region.size, 0x10000);
+		}
+		return candidate < limit && limit - candidate >= size ? candidate : 0;
+	}
+
+	bool overlaps(uint64_t address_, uint64_t size) const
+	{
+		auto next = regions.upper_bound(address_);
+		if (next != regions.end() && next->first < address_ + size)
+			return true;
+		if (next != regions.begin()) {
+			--next;
+			if (next->first + next->second.size > address_)
+				return true;
+		}
+		return false;
+	}
+
+	// Gives the guest address range back: the pieces of regions inside it are unmapped, the rest of a region stays.
+	void unmap(uint64_t address_, uint64_t size)
+	{
+		const uint64_t end = address_ + size;
+		auto it = regions.upper_bound(address_);
+		if (it != regions.begin())
+			--it;
+		while (it != regions.end() && it->first < end) {
+			const uint64_t base = it->first, top = base + it->second.size;
+			if (top <= address_) { ++it; continue; }
+			const uint64_t from = std::max(base, address_), to = std::min(top, end);
+				uc_mem_unmap(uc, from, to - from);
+#ifdef RAVEN_JIT
+				if (jit_mem)
+					jit_guest_unmap(from, to - from);
+#endif
+			Region region = std::move(it->second);
+			it = regions.erase(it);
+			if (from > base) {
+				Region left{from - base, region.host, region.block};
+				regions.emplace(base, std::move(left));
+			}
+			if (to < top) {
+				Region right{top - to, region.host + (to - base), region.block};
+				it = regions.emplace(to, std::move(right)).first;
+				++it;
+			}
+		}
+	}
+
+	// Maps host memory into the guest at `where`
+	void map(uint64_t where, uint64_t size, int protection, uint8_t *host, std::shared_ptr<HostBlock> block)
+	{
+		const auto result = uc_mem_map_ptr(uc, where, size, unicorn_rights(protection), host);
+		if (result != UC_ERR_OK)
+			fail("mmap", result);
+		regions.emplace(where, Region{size, host, std::move(block)});
+	}
+
+	const Region *find(uint64_t address_) const
+	{
+		auto it = regions.upper_bound(address_);
+		if (it == regions.begin())
+			return nullptr;
+		--it;
+		return address_ < it->first + it->second.size ? &it->second : nullptr;
+	}
+};
+
+namespace {
+
+// The hooks record why the guest stopped and end the emulation.
+struct Stops {
+	NativeChild::Emu *emu;
+};
+
+void on_interrupt(uc_engine *uc, uint32_t number, void *user)
+{
+	auto *emu = static_cast<NativeChild::Emu *>(user);
+	emu->happened = true;
+	emu->address = 0;
+	switch (number) {
+	case 3:
+		emu->signal = SIGTRAP;
+		emu->code = TRAP_BRKPT;
+		break;
+	case 1:
+		emu->signal = SIGTRAP;
+		emu->code = TRAP_TRACE;
+		break;
+	case 0:
+		emu->signal = SIGFPE;
+		emu->code = 1;
+		break;
+	case 6:
+		emu->signal = SIGILL;
+		emu->code = 1;
+		break;
+	default:
+		emu->signal = SIGSEGV;
+		emu->code = 0x80;
+	}
+	if (std::getenv("RAVEN_TRACE_STOPS"))
+		std::fprintf(stderr, "raven: guest interrupt %u at rip=%llx -> signal %d\n", number, (unsigned long long)emu->rip(), emu->signal);
+	uc_emu_stop(uc);
+}
+
+void on_syscall(uc_engine *uc, void *user)
+{
+	auto *emu = static_cast<NativeChild::Emu *>(user);
+	emu->happened = true;
+	emu->signal = SIGTRAP | 0x80;
+	emu->code = 0;
+	uint64_t rax = 0;
+	uc_reg_read(uc, UC_X86_REG_RAX, &rax);
+	emu->syscall_number = rax & 0xffffff;
+	uc_emu_stop(uc);
+}
+
+bool on_memory(uc_engine *uc, uc_mem_type type, uint64_t address, int, int64_t, void *user)
+{
+	auto *emu = static_cast<NativeChild::Emu *>(user);
+	emu->happened = true;
+	emu->signal = SIGSEGV;
+	const bool protection = type == UC_MEM_READ_PROT || type == UC_MEM_WRITE_PROT || type == UC_MEM_FETCH_PROT;
+	emu->code = protection ? 2 : 1;
+	emu->address = address;
+	if (std::getenv("RAVEN_TRACE_STOPS"))
+	{
+		uc_mem_region *list = nullptr;
+		uint32_t count = 0;
+		if (uc_mem_regions(uc, &list, &count) == UC_ERR_OK) {
+			for (uint32_t index = 0; index < count; ++index)
+				if (list[index].begin < 0x100000000ULL)
+					std::fprintf(stderr, "  region %llx-%llx perms %u\n", (unsigned long long)list[index].begin, (unsigned long long)list[index].end, list[index].perms);
+			uc_free(list);
+		}
+		uint64_t rsp = 0, ss = 0, cs = 0;
+		uc_reg_read(uc, UC_X86_REG_RSP, &rsp);
+		uc_reg_read(uc, UC_X86_REG_SS, &ss);
+		uc_reg_read(uc, UC_X86_REG_CS, &cs);
+		std::fprintf(stderr, "raven: guest memory fault type=%d address=%llx rip=%llx rsp=%llx cs=%llx ss=%llx\n", int(type), (unsigned long long)address,
+			(unsigned long long)emu->rip(), (unsigned long long)rsp, (unsigned long long)cs, (unsigned long long)ss);
+	}
+	uc_emu_stop(uc);
+	return false;
+}
+
+}
+
+#ifdef RAVEN_JIT
+namespace {
+
+// Runs a 64-bit guest in the JIT until it stops, in the way uc_emu_start does: returns a Unicorn result code, with e.happened and the
+// signal fields set for events the JIT itself recognizes (syscall, int3, ud2, faults). Instructions it cannot translate are run in
+// Unicorn (jit_uc_fallback), whose hooks end the run with the same fields.
+uc_err run_jit(NativeChild::Emu &e, std::chrono::steady_clock::time_point deadline)
+{
+	JitCtx *c = e.jc;
+	if (e.step) {
+		// a single step is one instruction in Unicorn
+		jit_to_uc(e.uc, c);
+		const uc_err result = uc_emu_start(e.uc, c->rip, ~uint64_t(0), 0, 1);
+		jit_from_uc(e.uc, c);
+		return result;
+	}
+	e.jpend = 0;
+	for (;;) {
+		e.running_jit = true;
+		const int status = jit_run(c);
+		e.running_jit = false;
+		switch (status) {
+		case JIT_SYSCALL:
+			e.happened = true;
+			e.signal = SIGTRAP | 0x80;
+			e.code = 0;
+			e.address = 0;
+			e.syscall_number = c->r[0] & 0xffffff;
+			return UC_ERR_OK;
+		case JIT_INT3:
+			e.happened = true;
+			e.signal = SIGTRAP;
+			e.code = TRAP_BRKPT;
+			e.address = 0;
+			return UC_ERR_OK;
+		case JIT_UD:
+			e.happened = true;
+			e.signal = SIGILL;
+			e.code = 1;
+			e.address = c->rip;
+			return UC_ERR_OK;
+		case JIT_FAULT: {
+			e.happened = true;
+			e.signal = SIGSEGV;
+			const uint64_t host = c->aux;
+			const uint64_t guest = host >= e.jdelta ? host - e.jdelta : host;
+			e.address = guest;
+			e.code = jit_guest_prot(guest) == 0xff ? 1 : 2;
+			if (std::getenv("RAVEN_TRACE_STOPS"))
+				std::fprintf(stderr, "raven: guest memory fault (JIT) address=%llx rip=%llx\n", (unsigned long long)guest, (unsigned long long)c->rip);
+			return UC_ERR_OK;
+		}
+		case JIT_PENDING:
+			if (std::chrono::steady_clock::now() >= deadline)
+				return UC_ERR_OK;   // the timeout: no event
+			e.jpend = 0;
+			continue;
+		case JIT_FALLBACK: {
+			if (jit_fb_histogram) {
+				auto &entry = (*jit_fb_histogram)[c->rip];
+				if (!entry.first) std::memcpy(&entry.second, reinterpret_cast<const void *>(e.jdelta + c->rip), 8);
+				++entry.first;
+			}
+			jit_fb_stop_flag = &e.happened;
+			const uc_err result = jit_uc_fallback(e.uc, c);
+			jit_fb_stop_flag = nullptr;
+			if (e.happened) {
+				jit_from_uc(e.uc, c);
+				return UC_ERR_OK;
+			}
+			if (result != UC_ERR_OK) {
+				jit_from_uc(e.uc, c);   // the state at the failing instruction, as Unicorn has it
+				return result;
+			}
+			continue;
+		}
+		default:
+			throw std::runtime_error("JIT: unexpected event " + std::to_string(status));
+		}
+	}
+}
+
+}
+#endif
+
+NativeChild::NativeChild(std::span<const int>, const std::string &, std::chrono::milliseconds timeout)
+	: emu(std::make_unique<Emu>()), deadline(std::chrono::steady_clock::now() + timeout)
+{
+	static std::atomic<pid_t> next_pid{0x40000000};
+	pid = next_pid.fetch_add(1);
+	auto &e = *emu;
+	e.start_watchdog();
+	uc_err result = uc_open(UC_ARCH_X86, UC_MODE_64, &e.uc);
+	if (result != UC_ERR_OK)
+		fail("uc_open", result);
+	// A CPU with SSE4.2 and POPCNT but no AVX, which Unicorn cannot run
+	uc_ctl_set_cpu_model(e.uc, UC_CPU_X86_NEHALEM);
+	const auto add = [&](int type, void *callback, uint64_t begin, uint64_t end, int extra) {
+		uc_hook hook;
+		result = extra >= 0 ? uc_hook_add(e.uc, &hook, type, callback, &e, begin, end, extra) : uc_hook_add(e.uc, &hook, type, callback, &e, begin, end);
+		if (result != UC_ERR_OK)
+			fail("uc_hook_add", result);
+		e.hooks[e.hook_count++] = hook;
+	};
+	add(UC_HOOK_INTR, reinterpret_cast<void *>(on_interrupt), 1, 0, -1);
+	add(UC_HOOK_INSN, reinterpret_cast<void *>(on_syscall), 1, 0, UC_X86_INS_SYSCALL);
+	// No hook for memory faults here: any memory hook makes Unicorn keep every store on its slow path (notdirty_write looks the
+	// address up each time). The fault hook is installed for one re-run of the faulting instruction (NativeChild::wait).
+	{
+		std::lock_guard lock(children_lock);
+		children[pid] = this;
+	}
+	// The gate page: int3; syscall; int3; ud2. The guest starts stopped right after the first int3, as the bootstrap does.
+	gate = gate_address;
+	auto block = std::make_shared<HostBlock>();
+	uint8_t *page = nullptr;
+#ifdef RAVEN_JIT
+	if (jit_window()) {
+		gate = jit_window() - 0x10000;
+		if (!jit_claimed.exchange(true)) {
+			e.jc = static_cast<JitCtx *>(std::aligned_alloc(16, (sizeof(JitCtx) + 15) & ~size_t(15)));
+			if (e.jc && jit_init(e.jc) == 0) {
+				e.jit_mem = e.jit_cpu = true;
+				if (std::getenv("RAVEN_TRACE_STATS") && !jit_fb_histogram)
+					jit_fb_histogram = new std::unordered_map<uint64_t, std::pair<uint64_t, uint64_t>>();
+				e.jdelta = jit_guest_delta();
+				e.jc->pend = &e.jpend;
+				e.jc->eflags = 2;
+				e.jc->expl = 1;
+			} else {
+				jit_claimed = false;
+			}
+		}
+	}
+	if (e.jit_mem) {
+		if (jit_guest_map(gate, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC) != 0)
+			throw std::runtime_error("native gate: cannot allocate JIT window memory");
+		page = reinterpret_cast<uint8_t *>(e.jdelta + gate);
+	} else
+#endif
+	{
+		block->size = host_page;
+		block->base = mmap(nullptr, block->size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+		if (block->base == MAP_FAILED) {
+			block->base = nullptr;
+			throw std::runtime_error("native gate: cannot allocate host memory");
+		}
+		block->mapped = true;
+		page = static_cast<uint8_t *>(block->base);
+	}
+	const uint8_t code[] = {0xcc, 0x0f, 0x05, 0xcc, 0x0f, 0x0b};
+	std::memcpy(page, code, sizeof code);
+	e.map(gate, 0x1000, PROT_READ | PROT_EXEC, page, e.jit_mem ? std::shared_ptr<HostBlock>() : block);
+	{
+		// the stub page: GDT with the 32-bit code (0x23), data (0x2b) and 64-bit code (0x33) segments of Linux; at +0x100 the far jump
+		const uint64_t entries[] = {0, 0, 0, 0, 0x00CF9B000000FFFFULL, 0x00CF93000000FFFFULL, 0x00AFFB000000FFFFULL, 0x00AFF3000000FFFFULL};
+		const uint8_t jump[] = {0x8e, 0x15, 0x1a, 0, 0, 0,   // mov ss, [rip + 0x1a]: the selector at +0x120 (loading it sets the 32-bit stack flag)
+			0xff, 0x2d, 0x04, 0, 0, 0};   // jmp far [rip + 4]: m16:32 at +0x110
+		const uint16_t stack_selector = 0x28;
+		std::memcpy(page + 0x800, entries, sizeof entries);
+		std::memcpy(page + 0x100, jump, sizeof jump);
+		std::memcpy(page + 0x120, &stack_selector, 2);
+		e.stub = gate + 0x100;
+		uc_x86_mmr table{0, gate + 0x800, sizeof entries - 1, 0};
+		uc_reg_write(e.uc, UC_X86_REG_GDTR, &table);
+	}
+	// SSE needs CR0.EM clear and CR4.OSFXSR and OSXMMEXCPT set, as an operating system leaves them; Unicorn starts with them off
+	uint64_t control = 0;
+	uc_reg_read(e.uc, UC_X86_REG_CR0, &control);
+	control = (control & ~uint64_t(4)) | 2;
+	uc_reg_write(e.uc, UC_X86_REG_CR0, &control);
+	uc_reg_read(e.uc, UC_X86_REG_CR4, &control);
+	control |= 0x600;
+	uc_reg_write(e.uc, UC_X86_REG_CR4, &control);
+	uint64_t selector = 0x33;
+	uc_reg_write(e.uc, UC_X86_REG_CS, &selector);
+	selector = 0x2b;
+	uc_reg_write(e.uc, UC_X86_REG_SS, &selector);
+	e.set_rip(gate + 1);
+	e.stopped = true;
+	e.signal = SIGTRAP;
+	e.code = TRAP_BRKPT;
+}
+
+NativeChild::~NativeChild()
+{
+	stop();
+}
+
+void NativeChild::set_timeout(std::chrono::milliseconds timeout)
+{
+	if (timeout.count() <= 0)
+		throw std::runtime_error("native execution requires a positive timeout");
+	deadline = std::chrono::steady_clock::now() + timeout;
+}
+
+void NativeChild::enable_parallel()
+{
+	throw std::runtime_error("parallel native execution is not supported with Unicorn");
+}
+
+pid_t NativeChild::clone_task(uint64_t)
+{
+	throw std::runtime_error("parallel native execution is not supported with Unicorn");
+}
+
+void NativeChild::stop()
+{
+	if (pid != -1) {
+		std::lock_guard lock(children_lock);
+		children.erase(pid);
+	}
+	pid = -1;
+	if (emu)
+		emu->stop_watchdog();
+	if (emu && emu->uc) {
+		for (size_t index = 0; index < emu->hook_count; ++index)
+			uc_hook_del(emu->uc, emu->hooks[index]);
+		emu->hook_count = 0;
+		emu->regions.clear();
+		uc_close(emu->uc);
+		emu->uc = nullptr;
+	}
+}
+
+// Runs the guest until it stops, as waitpid does for a traced process: the wait status of a stop is the signal in the second byte
+int NativeChild::wait(const std::function<bool()> *)
+{
+	if (!emu || !emu->uc)
+		return -1;
+	auto &e = *emu;
+	if (!e.run)
+		return -1;
+	e.run = false;
+	const auto now = std::chrono::steady_clock::now();
+	if (now >= deadline)
+		return -1;
+	const auto remaining = std::chrono::duration_cast<std::chrono::microseconds>(deadline - now).count();
+	e.happened = false;
+	const uint64_t start = e.rip();
+	if (e.compat_pending && start == e.stub)
+		e.compat = true;   // the far jump is the first instruction that runs
+	e.compat_pending = false;
+	const auto began = std::chrono::steady_clock::now();
+	e.arm(deadline);
+#ifdef RAVEN_JIT
+	const uc_err result = e.jit_cpu ? run_jit(e, deadline) : uc_emu_start(e.uc, start, ~uint64_t(0), 0, e.step ? 1 : 0);
+#else
+	const uc_err result = uc_emu_start(e.uc, start, ~uint64_t(0), 0, e.step ? 1 : 0);
+#endif
+	e.disarm();
+	++stats.starts;
+	if (!e.happened && (result == UC_ERR_READ_UNMAPPED || result == UC_ERR_WRITE_UNMAPPED || result == UC_ERR_FETCH_UNMAPPED || result == UC_ERR_READ_PROT ||
+		result == UC_ERR_WRITE_PROT || result == UC_ERR_FETCH_PROT)) {
+		// The error does not say where: run the instruction again with the fault hook, which records the address and the kind
+		uc_hook hook;
+		if (uc_hook_add(e.uc, &hook, UC_HOOK_MEM_READ_UNMAPPED | UC_HOOK_MEM_WRITE_UNMAPPED | UC_HOOK_MEM_FETCH_UNMAPPED | UC_HOOK_MEM_READ_PROT |
+			UC_HOOK_MEM_WRITE_PROT | UC_HOOK_MEM_FETCH_PROT, reinterpret_cast<void *>(on_memory), &e, 1, 0) == UC_ERR_OK) {
+			uc_emu_start(e.uc, e.rip(), ~uint64_t(0), 0, 1);
+			uc_hook_del(e.uc, hook);
+		}
+	}
+	stats.emu_ns += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - began).count());
+	e.step = false;
+	e.stopped = true;
+	if (e.happened) {
+		// int3: the guest stopped after the instruction, as on x86; the syscall instruction: execution continues after it
+		if (e.signal == (SIGTRAP | 0x80)) {
+			// Unicorn leaves rip after the instruction by itself
+		}
+	} else if (result == UC_ERR_OK) {
+		// A single step ends without a hook; a longer run ending without one was the timeout
+		if (e.step || remaining <= 0) {
+			e.signal = SIGTRAP;
+			e.code = TRAP_TRACE;
+		} else {
+			uint64_t after = e.rip();
+			if (std::chrono::steady_clock::now() >= deadline) {
+				e.happened = false;
+				(void)after;
+				return -1;
+			}
+			e.signal = SIGTRAP;
+			e.code = TRAP_TRACE;
+		}
+	} else {
+		switch (result) {
+		case UC_ERR_INSN_INVALID:
+			e.signal = SIGILL;
+			e.code = 1;
+			e.address = e.rip();
+			break;
+		case UC_ERR_EXCEPTION:
+			e.signal = SIGSEGV;
+			e.code = 0x80;
+			e.address = 0;
+			break;
+		default:
+			e.signal = SIGSEGV;
+			e.code = 1;
+			e.address = e.rip();
+		}
+		if (std::getenv("RAVEN_TRACE_STOPS"))
+			std::fprintf(stderr, "raven: guest stopped with %s at rip=%llx -> signal %d\n", uc_strerror(result), (unsigned long long)e.rip(), e.signal);
+	}
+	return (e.signal << 8) | 0x7f;
+}
+
+ssize_t NativeChild::read_memory(uint64_t address, void *buffer, size_t size)
+{
+	++stats.reads;
+#ifdef RAVEN_JIT
+	if (emu && emu->jit_mem) {
+		if (!emu->uc || jit_guest_copy(address, buffer, size, 0) != 0) {
+			errno = EFAULT;
+			return -1;
+		}
+		return ssize_t(size);
+	}
+#endif
+	if (!emu || !emu->uc || uc_mem_read(emu->uc, address, buffer, size) != UC_ERR_OK) {
+		errno = EFAULT;
+		return -1;
+	}
+	return ssize_t(size);
+}
+
+ssize_t NativeChild::write_memory(uint64_t address, const void *buffer, size_t size)
+{
+	++stats.writes;
+#ifdef RAVEN_JIT
+	if (emu && emu->jit_mem) {
+		if (!emu->uc || jit_guest_copy(address, const_cast<void *>(buffer), size, 1) != 0) {
+			errno = EFAULT;
+			return -1;
+		}
+		return ssize_t(size);
+	}
+#endif
+	if (!emu || !emu->uc || uc_mem_write(emu->uc, address, buffer, size) != UC_ERR_OK) {
+		errno = EFAULT;
+		return -1;
+	}
+	return ssize_t(size);
+}
+
+uint64_t NativeChild::low_gap(uint64_t size, uint64_t limit)
+{
+	return emu ? emu->find_gap(size, 0x20000, limit) : 0;
+}
