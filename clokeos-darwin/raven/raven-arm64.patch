+namespace {
+
+// ptrace's register block and Unicorn's registers
+constexpr int register_ids[] = {UC_X86_REG_R15, UC_X86_REG_R14, UC_X86_REG_R13, UC_X86_REG_R12, UC_X86_REG_RBP, UC_X86_REG_RBX, UC_X86_REG_R11,
+	UC_X86_REG_R10, UC_X86_REG_R9, UC_X86_REG_R8, UC_X86_REG_RAX, UC_X86_REG_RCX, UC_X86_REG_RDX, UC_X86_REG_RSI, UC_X86_REG_RDI};
+
+}
+
+long NativeChild::request(enum __ptrace_request operation, void *address, void *data)
+{
+	if (!emu || !emu->uc) {
+		errno = ESRCH;
+		return -1;
+	}
+	auto &e = *emu;
+	switch (operation) {
+	case PTRACE_CONT:
+	case PTRACE_SYSEMU:
+		e.run = true;
+		e.step = false;
+		return 0;
+	case PTRACE_SINGLESTEP:
+		e.run = true;
+		e.step = true;
+		return 0;
+	case PTRACE_SETOPTIONS:
+		return 0;
+	case PTRACE_GETREGS: {
+			auto &r = *static_cast<user_regs_struct *>(data);
+			r = {};
+#ifdef RAVEN_JIT
+			if (e.jit_cpu) {
+				const JitCtx &c = *e.jc;
+				r.r15 = c.r[15]; r.r14 = c.r[14]; r.r13 = c.r[13]; r.r12 = c.r[12]; r.rbp = c.r[5]; r.rbx = c.r[3]; r.r11 = c.r[11]; r.r10 = c.r[10];
+				r.r9 = c.r[9]; r.r8 = c.r[8]; r.rax = c.r[0]; r.rcx = c.r[1]; r.rdx = c.r[2]; r.rsi = c.r[6]; r.rdi = c.r[7]; r.rsp = c.r[4];
+				r.rip = c.rip;
+				r.eflags = jit_eflags_of(&c);
+				r.cs = 0x33; r.ss = r.ds = r.es = 0x2b; r.fs = r.gs = 0;
+				r.fs_base = c.fs_base; r.gs_base = c.gs_base;
+				r.orig_rax = e.signal == (SIGTRAP | 0x80) ? e.syscall_number : uint64_t(-1);
+				return 0;
+			}
+#endif
+			unsigned long long *fields[] = {&r.r15, &r.r14, &r.r13, &r.r12, &r.rbp, &r.rbx, &r.r11, &r.r10, &r.r9, &r.r8, &r.rax, &r.rcx, &r.rdx, &r.rsi, &r.rdi};
+		for (size_t index = 0; index < std::size(register_ids); ++index) {
+			uint64_t value = 0;
+			uc_reg_read(e.uc, register_ids[index], &value);
+			*fields[index] = value;
+		}
+		uint64_t value = 0;
+		uc_reg_read(e.uc, UC_X86_REG_RIP, &value); r.rip = value;
+		if (e.compat_pending) {
+			uint32_t target = 0;
+			uc_mem_read(e.uc, e.stub + 0x10, &target, 4);   // the jump's target
+			r.rip = target;
+		}
+		uc_reg_read(e.uc, UC_X86_REG_RSP, &value); r.rsp = value;
+		uc_reg_read(e.uc, UC_X86_REG_EFLAGS, &value); r.eflags = value;
+		uc_reg_read(e.uc, UC_X86_REG_CS, &value); r.cs = value;
+		uc_reg_read(e.uc, UC_X86_REG_SS, &value); r.ss = value;
+		uc_reg_read(e.uc, UC_X86_REG_DS, &value); r.ds = value;
+		uc_reg_read(e.uc, UC_X86_REG_ES, &value); r.es = value;
+		if (e.compat || e.compat_pending) {
+			r.cs = 0x23;   // the selectors of Linux's x86 user mode; the engine's own are the DPL 0 pair
+			r.ss = r.ds = r.es = 0x2b;
+		}
+		uc_reg_read(e.uc, UC_X86_REG_FS, &value); r.fs = e.compat ? e.fs_shadow : value;
+		uc_reg_read(e.uc, UC_X86_REG_GS, &value); r.gs = value;
+		uc_reg_read(e.uc, UC_X86_REG_FS_BASE, &value); r.fs_base = value;
+		uc_reg_read(e.uc, UC_X86_REG_GS_BASE, &value); r.gs_base = value;
+		r.orig_rax = e.signal == (SIGTRAP | 0x80) ? e.syscall_number : uint64_t(-1);
+		return 0;
+	}
+	case PTRACE_SETREGS: {
+			const auto &r = *static_cast<const user_regs_struct *>(data);
+#ifdef RAVEN_JIT
+			if (e.jit_cpu && r.cs != 0x23) {
+				JitCtx &c = *e.jc;
+				c.r[15] = r.r15; c.r[14] = r.r14; c.r[13] = r.r13; c.r[12] = r.r12; c.r[5] = r.rbp; c.r[3] = r.rbx; c.r[11] = r.r11; c.r[10] = r.r10;
+				c.r[9] = r.r9; c.r[8] = r.r8; c.r[0] = r.rax; c.r[1] = r.rcx; c.r[2] = r.rdx; c.r[6] = r.rsi; c.r[7] = r.rdi; c.r[4] = r.rsp;
+				c.rip = r.rip;
+				jit_set_eflags(&c, r.eflags);
+				c.fs_base = r.fs_base; c.gs_base = r.gs_base;
+				e.signal = e.signal == (SIGTRAP | 0x80) ? SIGTRAP : e.signal;
+				return 0;
+			}
+			if (e.jit_cpu) {   // a 32-bit guest: the registers move to Unicorn, which runs it in compatibility mode from here on
+				jit_to_uc(e.uc, e.jc);
+				e.jit_cpu = false;
+			}
+#endif
+			const unsigned long long fields[] = {r.r15, r.r14, r.r13, r.r12, r.rbp, r.rbx, r.r11, r.r10, r.r9, r.r8, r.rax, r.rcx, r.rdx, r.rsi, r.rdi};
+		for (size_t index = 0; index < std::size(register_ids); ++index) {
+			uint64_t value = fields[index];
+			uc_reg_write(e.uc, register_ids[index], &value);
+		}
+		uint64_t value = r.rip;
+		if (std::getenv("RAVEN_TRACE_REGS"))
+			std::fprintf(stderr, "raven: SETREGS cs=%llx rip=%llx rsp=%llx fs=%llx fs_base=%llx compat=%d\n", (unsigned long long)r.cs, (unsigned long long)r.rip,
+				(unsigned long long)r.rsp, (unsigned long long)r.fs, (unsigned long long)r.fs_base, int(e.compat));
+		if (r.cs == 0x23 && !e.compat) {
+			// into compatibility mode through the stub's far jump
+			const uint8_t pointer[6] = {uint8_t(r.rip), uint8_t(r.rip >> 8), uint8_t(r.rip >> 16), uint8_t(r.rip >> 24), 0x20, 0};   // DPL 0 like the engine's CPL; reported as 0x23
+			uc_mem_write(e.uc, e.stub + 0x10, pointer, sizeof pointer);
+			value = e.stub;
+			e.compat_pending = true;
+		} else if (r.cs != 0x23 && e.compat) {
+			throw std::runtime_error("native guest cannot leave compatibility mode");
+		} else {
+			e.compat_pending = false;
+		}
+		uc_reg_write(e.uc, UC_X86_REG_RIP, &value);
+		if (r.cs == 0x23) {
+			uint64_t selector = 0x28;
+			uc_reg_write(e.uc, UC_X86_REG_SS, &selector);
+			uc_reg_write(e.uc, UC_X86_REG_DS, &selector);
+			uc_reg_write(e.uc, UC_X86_REG_ES, &selector);
+			uc_reg_write(e.uc, UC_X86_REG_FS, &selector);   // the LDT selector would not load; the base below is what counts
+			e.fs_shadow = uint16_t(r.fs);
+		}
+		value = r.rsp; uc_reg_write(e.uc, UC_X86_REG_RSP, &value);
+		value = r.eflags; uc_reg_write(e.uc, UC_X86_REG_EFLAGS, &value);
+		value = r.fs_base; uc_reg_write(e.uc, UC_X86_REG_FS_BASE, &value);
+		value = r.gs_base; uc_reg_write(e.uc, UC_X86_REG_GS_BASE, &value);
+		e.signal = e.signal == (SIGTRAP | 0x80) ? SIGTRAP : e.signal;
+		return 0;
+	}
+	case PTRACE_GETSIGINFO: {
+		auto *info = static_cast<siginfo_t *>(data);
+		*info = {};
+		info->si_signo = e.signal & 0x7f;
+		info->si_code = e.code;
+		info->si_addr = reinterpret_cast<void *>(e.address);
+		return 0;
+	}
+	case PTRACE_GETFPREGS: {
+		// FXSAVE layout: control and status words, MXCSR, the x87 registers and XMM0 to XMM15
+		auto *area = static_cast<uint8_t *>(data);
+		std::memset(area, 0, 512);
+			uint64_t word = 0;
+			uc_reg_read(e.uc, UC_X86_REG_FPCW, &word); const uint16_t control = uint16_t(word);
+			uc_reg_read(e.uc, UC_X86_REG_FPSW, &word); const uint16_t status = uint16_t(word);
+			uint32_t mxcsr = 0;
+			uc_reg_read(e.uc, UC_X86_REG_MXCSR, &mxcsr);
+#ifdef RAVEN_JIT
+			if (e.jit_cpu)
+				mxcsr = e.jc->mxcsr;
+#endif
+		std::memcpy(area, &control, 2);
+		std::memcpy(area + 2, &status, 2);
+		std::memcpy(area + 24, &mxcsr, 4);
+		const uint32_t mask = 0xffff;
+		std::memcpy(area + 28, &mask, 4);
+		for (int index = 0; index < 16; ++index) {
+				uint8_t xmm[16] = {};
+#ifdef RAVEN_JIT
+				if (e.jit_cpu)
+					std::memcpy(xmm, e.jc->xmm[index], 16);
+				else
+#endif
+				uc_reg_read(e.uc, UC_X86_REG_XMM0 + index, xmm);
+				std::memcpy(area + 160 + index * 16, xmm, 16);
+		}
+		return 0;
+	}
+	case PTRACE_GETREGSET:
+	case PTRACE_SETREGSET: {
+		auto *vector = static_cast<iovec *>(data);
+		constexpr size_t size = 576;   // the legacy area and the header of the extended state; no AVX in Unicorn
+		if (operation == PTRACE_GETREGSET) {
+			if (vector->iov_len < size) { errno = EINVAL; return -1; }
+			auto *out = static_cast<uint8_t *>(vector->iov_base);
+			if (request(PTRACE_GETFPREGS, nullptr, out) != 0)
+				return -1;
+			std::memset(out + 512, 0, 64);
+			const uint64_t mask = 3;
+			std::memcpy(out + 512, &mask, 8);
+			vector->iov_len = size;
+			return 0;
+		}
+		if (vector->iov_len < 512) { errno = EINVAL; return -1; }
+		const auto *in = static_cast<const uint8_t *>(vector->iov_base);
+		uint16_t control = 0, status = 0;
+		uint32_t mxcsr = 0;
+		std::memcpy(&control, in, 2);
+		std::memcpy(&status, in + 2, 2);
+		std::memcpy(&mxcsr, in + 24, 4);
+		uint64_t word = control; uc_reg_write(e.uc, UC_X86_REG_FPCW, &word);
+		word = status; uc_reg_write(e.uc, UC_X86_REG_FPSW, &word);
+			uc_reg_write(e.uc, UC_X86_REG_MXCSR, &mxcsr);
+			for (int index = 0; index < 16; ++index) {
+				uint8_t xmm[16];
+				std::memcpy(xmm, in + 160 + index * 16, 16);
+				uc_reg_write(e.uc, UC_X86_REG_XMM0 + index, xmm);
+#ifdef RAVEN_JIT
+				if (e.jit_cpu)
+					std::memcpy(e.jc->xmm[index], xmm, 16);
+#endif
+			}
+#ifdef RAVEN_JIT
+			if (e.jit_cpu)
+				e.jc->mxcsr = mxcsr;
+#endif
+		return 0;
+	}
+	case PTRACE_PEEKTEXT:
+	case PTRACE_PEEKDATA: {
+		uint64_t word = 0;
+		errno = 0;
+		if (read_memory(reinterpret_cast<uint64_t>(address), &word, sizeof word) != ssize_t(sizeof word)) {
+			errno = EIO;
+			return -1;
+		}
+		return long(word);
+	}
+	case PTRACE_POKEUSER:
+		return 0;
+	default:
+		errno = ENOSYS;
+		return -1;
+	}
+}
+
+uint64_t NativeChild::syscall(uint64_t number, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4, uint64_t a5, uint64_t a6)
+{
+	if (!emu || !emu->uc)
+		throw std::runtime_error("native guest is gone");
+	auto &e = *emu;
+	if (number < 512)
+		++stats.syscalls[number];
+	switch (number) {
+	case SYS_mmap: {
+		uint64_t address = a1;
+		const uint64_t size = round_up(a2, 0x1000);
+		const int protection = int(a3), flags = int(a4);
+		const int descriptor = int(a5);
+		const uint64_t offset = a6;
+		const bool fixed = (flags & (MAP_FIXED | MAP_FIXED_NOREPLACE)) && address;
+		if (!size)
+			throw std::runtime_error("native mmap: empty mapping");
+		if (fixed) {
+			if (flags & MAP_FIXED)
+				e.unmap(address, size);
+			else if (e.overlaps(address, size))
+				throw std::runtime_error("native mmap: the range is taken");
+		} else if (flags & MAP_32BIT) {
+			address = e.find_gap(size, 0x20000, 0x100000000ULL);
+			if (!address)
+				throw std::runtime_error("native mmap: no 32-bit address space left");
+		} else {
+#ifdef RAVEN_JIT
+			if (jit_window())
+				address = e.find_gap(size, jit_window() - 0x80000000ULL + 0x40000000ULL, jit_window() - 0x100000ULL);
+			else
+#endif
+			address = e.find_gap(size, anywhere_start, 0x800000000000ULL);
+			if (!address)
+				throw std::runtime_error("native mmap: no address space left");
+		}
+#ifdef RAVEN_JIT
+		if (e.jit_mem) {
+			// The guest's memory is the JIT's window: anonymous memory is made in place, a shared object (a PE image, a section) is
+			// mapped from its descriptor at the same offset within a 16 KiB host page, so host and guest see the same bytes.
+			uint8_t *host = reinterpret_cast<uint8_t *>(e.jdelta + address);
+			if (flags & MAP_ANON) {
+				if (jit_guest_map(address, size, protection) != 0)
+					throw std::runtime_error("native mmap: out of JIT window memory");
+			} else {
+				const int result = jit_guest_map_fd(address, size, protection, descriptor, offset);
+				if (result != 0) {
+					// not 16 KiB aligned like the file offset: a private copy (changes the guest makes are not seen by the host)
+					if (jit_guest_map(address, size, PROT_READ | PROT_WRITE) != 0)
+						throw std::runtime_error("native mmap: out of JIT window memory");
+					std::vector<uint8_t> copy(size);
+					const ssize_t got = pread(descriptor, copy.data(), size, off_t(offset));
+					if (got > 0)
+						std::memcpy(host, copy.data(), size_t(got));
+					jit_guest_protect(address, size, protection);
+					if (std::getenv("RAVEN_TRACE_STOPS"))
+						std::fprintf(stderr, "raven: JIT mapping of descriptor %d at %llx is a private copy (code %d)\n", descriptor, (unsigned long long)address, result);
+				}
+			}
+			e.map(address, size, protection, host, nullptr);
+			return address;
+		}
+#endif
+		auto block = std::make_shared<HostBlock>();
+		if (flags & MAP_ANON) {
+			block->size = round_up(size, host_page);
+			void *host = mmap(nullptr, block->size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+			if (host == MAP_FAILED)
+				throw std::runtime_error("native mmap: out of host memory");
+			block->base = host;
+			block->mapped = true;
+			e.map(address, size, protection, static_cast<uint8_t *>(host), block);
+			return address;
+		}
+		std::pair<void *, size_t> image{nullptr, 0};
+		{
+			std::lock_guard lock(images_lock);
+			const auto found = images.find(descriptor);
+			if (found != images.end())
+				image = found->second;
+		}
+		if (image.first && offset == 0 && size <= round_up(image.second, 0x1000)) {
+			// a PE image: the guest works on the storage the host reads and patches, so both see the same bytes
+			block->base = image.first;
+			block->size = image.second;
+			e.map(address, size, protection, static_cast<uint8_t *>(image.first), block);
+			return address;
+		}
+		// a shared object: the host maps it, the guest uses the same pages
+		const size_t length = size_t(round_up(a2, host_page));
+		void *view = mmap(nullptr, length, PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, off_t(offset));
+		if (view == MAP_FAILED)
+			throw std::runtime_error("native mmap: cannot map the shared object in the host: " + std::string(std::strerror(errno)));
+		block->base = view;
+		block->size = length;
+		block->mapped = true;
+		e.map(address, size, protection, static_cast<uint8_t *>(view), block);
+		return address;
+	}
+	case SYS_mprotect: {
+		const auto result = uc_mem_protect(e.uc, a1, round_up(a2, 0x1000), unicorn_rights(int(a3)));
+		if (result != UC_ERR_OK)
+			fail("mprotect", result);
+#ifdef RAVEN_JIT
+		if (e.jit_mem)
+			jit_guest_protect(a1, round_up(a2, 0x1000), int(a3));
+#endif
+		return 0;
+	}
+	case SYS_munmap:
+		e.unmap(a1, round_up(a2, 0x1000));
+		return 0;
+	case SYS_madvise: {
+		// MADV_DONTNEED: the pages read as zero again
+		const uint64_t size = round_up(a2, 0x1000);
+		for (uint64_t at = a1 & ~uint64_t(0xfff); at < a1 + size;) {
+			const Region *region = e.find(at);
+			if (!region) { at += 0x1000; continue; }
+			const uint64_t base = [&] { auto it = e.regions.upper_bound(at); --it; return it->first; }();
+			const uint64_t end = std::min(base + region->size, a1 + size);
+			std::memset(region->host + (at - base), 0, end - at);
+			at = end;
+		}
+		return 0;
+	}
+	case SYS_openat: {
+		// the descriptor named as /proc/<pid>/fd/<n> is the host's own: the guest and the host share one descriptor table here
+		char path[128] = {};
+		if (read_memory(a2, path, sizeof path - 1) < 0)
+			throw std::runtime_error("native openat: cannot read the path");
+		const char *marker = std::strstr(path, "/fd/");
+		if (!marker)
+			throw std::runtime_error("native openat: unsupported path");
+		return uint64_t(std::atoi(marker + 4));
+	}
+	case SYS_modify_ldt:
+		return 0;   // the TEB descriptor: SETREGS sets FS base directly
+	case SYS_prctl:
+	case SYS_seccomp:
+	case SYS_close:
+		return 0;
+	default:
+		throw std::runtime_error("native syscall " + std::to_string(number) + " is not available with Unicorn");
+	}
+}
+
+}
+#endif
